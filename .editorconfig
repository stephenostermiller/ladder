root = true

# All files
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# Java files - tab indentation
[*.java]
indent_style = tab
indent_size = 4

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 4

# Makefile - requires tabs
[Makefile]
indent_style = tab

# CSS files
[*.css]
indent_style = tab
indent_size = 2

# HTML/BTE templates
[*.{html,bte}]
indent_style = tab
indent_size = 2

# Configuration files
[*.{ini,dict,properties}]
indent_style = tab
indent_size = 2

# YAML/JSON
[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
