root = true

# All files
[*]
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
charset = utf-8

[*.{css,htm,html,bte,ini,dict,properties,json}]
indent_style = tab
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.lvl]
indent_style = space
indent_size = 1
