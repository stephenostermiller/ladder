<%bte.tpl name=homeLinkText %><a href="./">Home</a> - Ladder main page.<%/bte.tpl%>
<%bte.tpl name=levelsLinkText %><a href="levels.html">Levels</a> - Existing levels, and creating and submitting new levels.<%/bte.tpl%>
<%bte.tpl name=differencesLinkText %><a href="differences.html">Differences</a> - Changes in this version from the original for Kaypro and CP/M.<%/bte.tpl%>
<%bte.tpl name=downloadLinkText %><a href="download.html">Download</a> - Get Ladder and the source code (free).<%/bte.tpl%>
<%bte.tpl name=instructionsLinkText %><a href="instructions.html">Instructions</a> - How to play.<%/bte.tpl%>
<%bte.tpl name=historyLinkText %><a href="history.html">History</a> - List of features and bug fixes in each release.<%/bte.tpl%>
<%bte.tpl name=forumsLinkText %><a href="http://sourceforge.net/forum/forum.php?forum_id=179106">Forums</a> - Unmoderated game discussion.<%/bte.tpl%>
<%bte.tpl name=announcementsLinkText %><a href="http://lists.sourceforge.net/lists/listinfo/laddergame-updates">Announcements</a> - Subscribe to a moderated mailing list used only for announcing new versions.<%/bte.tpl%>
<%bte.tpl name=sourceLinkText %><a href="http://www.gjt.org/servlets/JCVSlet/list/gjt/com/Ostermiller/Ladder/">Source Code</a> - Browse the source code for the game in your web browser.<%/bte.tpl%>
<%bte.tpl name=javadocLinkText %><a href="http://www.gjt.org/javadoc/com/Ostermiller/Ladder/package-summary.html">JavaDoc</a> - Documentation for the source code.<%/bte.tpl%>
<%bte.tpl name=bugsLinkText %><a href="http://sourceforge.net/tracker/?group_id=53718&atid=471349">Bugs</a> - View existing bugs and submit new ones.<%/bte.tpl%>
<%bte.tpl name=featuresLinkText %><a href="http://sourceforge.net/tracker/?func=browse&group_id=53718&atid=471352">Feature Requests</a> - View features that others want, or ask for your own.<%/bte.tpl%>
<%bte.tpl name=licenseLinkText %><a href="license.html">License</a> - Ladder is freely available under the GNU General Public License.<%/bte.tpl%>
<%bte.tpl name=customizeLinkText %><a href="customize.html">Customize</a> - Tips and tricks.<%/bte.tpl%>
